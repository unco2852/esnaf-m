rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Existing catalog uploads stay available to signed-in customers; only the owner can change them.
    match /{catalogFolder}/{merchantId}/{fileName} {
      allow read: if request.auth != null
                  && catalogFolder in ['product_images', 'service_images'];
      allow create, update: if request.auth != null
                            && catalogFolder in ['product_images', 'service_images']
                            && request.auth.uid == merchantId
                            && request.resource.size <= 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && catalogFolder in ['product_images', 'service_images']
                    && request.auth.uid == merchantId;
    }

    match /merchant_chats/{merchantId}/{customerId}/{messageId} {
      function hasConversation() {
        let conversationPath = /databases/(default)/documents/merchant_conversations/$(merchantId + '--' + customerId);
        return firestore.exists(conversationPath)
               && firestore.get(conversationPath).data.merchantId == merchantId
               && firestore.get(conversationPath).data.customerId == customerId;
      }

      allow read: if request.auth != null
                  && (request.auth.uid == merchantId || request.auth.uid == customerId)
                  && hasConversation();

      allow create: if request.auth != null
                    && (request.auth.uid == merchantId || request.auth.uid == customerId)
                    && hasConversation()
                    && ((request.resource.contentType.matches('video/.*')
                         && request.resource.size <= 100 * 1024 * 1024)
                        || (!request.resource.contentType.matches('video/.*')
                            && request.resource.size <= 25 * 1024 * 1024))
                    && request.resource.contentType != null;

      allow delete: if request.auth != null
                    && (request.auth.uid == merchantId || request.auth.uid == customerId);
      allow update: if false;
    }
  }
}
