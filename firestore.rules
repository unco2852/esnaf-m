rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcılar Koleksiyonu Kuralları
    match /users/{userId} {
      // This document is private: only its owner can read personal data.
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['CUSTOMER', 'MERCHANT'];

      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                        || resource.data.role == request.resource.data.role);

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Adresler Alt Koleksiyonu
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /favorites/{merchantId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.merchantId == merchantId
                      && request.resource.data.keys().hasOnly(['merchantId', 'createdAt']);
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /notification_tokens/{tokenId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && tokenId.matches('^[0-9a-f]{64}$')
                              && request.resource.data.token is string
                              && request.resource.data.token.size() <= 4096
                              && request.resource.data.platform == 'android'
                              && request.resource.data.updatedAt is int
                              && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && settingId == 'notifications'
                              && request.resource.data.keys().hasOnly([
                                'allNotifications', 'appointments', 'orders', 'messages', 'campaigns'
                              ])
                              && request.resource.data.allNotifications is bool
                              && request.resource.data.appointments is bool
                              && request.resource.data.orders is bool
                              && request.resource.data.messages is bool
                              && request.resource.data.campaigns is bool;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public business listing. Personal account fields remain in /users/{uid}.
    match /public_merchants/{merchantId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == merchantId
                    && getAfter(/databases/$(database)/documents/users/$(merchantId)).data.role == 'MERCHANT'
                    && request.resource.data.uid == merchantId
                    && request.resource.data.role == 'MERCHANT'
                    && request.resource.data.keys().hasOnly([
                      'uid', 'role', 'businessName', 'category', 'businessDescription',
                      'businessPhone', 'businessAddress', 'workingHours', 'businessLogoUrl',
                      'businessLatitude', 'businessLongitude', 'city', 'district', 'isOpen', 'isDemo'
                    ])
                    && request.resource.data.businessName is string
                    && request.resource.data.businessName.size() > 0
                    && request.resource.data.category is string
                    && request.resource.data.businessPhone is string
                    && request.resource.data.businessAddress is string
                    && request.resource.data.isOpen is bool
                    && (!('isDemo' in request.resource.data) || request.resource.data.isDemo is bool);
      allow update: if request.auth != null
                    && request.auth.uid == merchantId
                    && resource.data.uid == merchantId
                    && request.resource.data.uid == merchantId
                    && resource.data.role == 'MERCHANT'
                    && request.resource.data.role == 'MERCHANT'
                    && get(/databases/$(database)/documents/users/$(merchantId)).data.role == 'MERCHANT'
                    && request.resource.data.keys().hasOnly([
                      'uid', 'role', 'businessName', 'category', 'businessDescription',
                      'businessPhone', 'businessAddress', 'workingHours', 'businessLogoUrl',
                      'businessLatitude', 'businessLongitude', 'city', 'district', 'isOpen', 'isDemo'
                    ])
                    && request.resource.data.businessName is string
                    && request.resource.data.businessName.size() > 0
                    && request.resource.data.category is string
                    && request.resource.data.businessPhone is string
                    && request.resource.data.businessAddress is string
                    && request.resource.data.isOpen is bool
                    && (!('isDemo' in request.resource.data) || request.resource.data.isDemo is bool);
      allow delete: if request.auth != null && request.auth.uid == merchantId;
    }

    // Ürünler Koleksiyonu
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MERCHANT'
                    && request.resource.data.merchantId == request.auth.uid;
      // Customer stock changes are accepted only with the matching order in the same atomic write.
      allow update: if request.auth != null
                    && ((resource.data.merchantId == request.auth.uid
                         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MERCHANT'
                         && request.resource.data.merchantId == resource.data.merchantId)
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockReservationOrderId'])
                            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['stock', 'stockReservationOrderId'])
                            && request.resource.data.stock is int
                            && request.resource.data.stock >= 0
                            && request.resource.data.stock < resource.data.stock
                            && request.resource.data.stockReservationOrderId is string
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReservationOrderId)).data.itemId == itemId
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReservationOrderId)).data.customerId == request.auth.uid
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReservationOrderId)).data.merchantId == resource.data.merchantId
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReservationOrderId)).data.status == 'pending'
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReservationOrderId)).data.quantity == resource.data.stock - request.resource.data.stock)
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockReleaseOrderId'])
                            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['stock', 'stockReleaseOrderId'])
                            && request.resource.data.stock is int
                            && request.resource.data.stock > resource.data.stock
                            && request.resource.data.stockReleaseOrderId is string
                            && get(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.status in ['pending', 'confirmed']
                            && !('stockRestoredAt' in get(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data)
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.itemId == itemId
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.merchantId == resource.data.merchantId
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.status == 'cancelled'
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.stockRestoredAt is int
                            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.quantity == request.resource.data.stock - resource.data.stock
                            && ((getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.customerId == request.auth.uid
                                 && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.cancellationReason == 'customer_cancelled')
                                || (getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.merchantId == request.auth.uid
                                    && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.stockReleaseOrderId)).data.cancellationReason == 'merchant_cancelled'))));
      allow delete: if request.auth != null
                    && resource.data.merchantId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MERCHANT';
    }

    // Siparişler: yalnızca ilgili müşteri ve esnaf okuyabilir; yeni sipariş
    // gerçek ürün/stok bilgileriyle aynı transaction içinde yazılmalıdır.
    match /orders/{orderId} {
      function stockReleaseMatchesOrder() {
        let itemPath = /databases/$(database)/documents/items/$(resource.data.itemId);
        let itemBefore = get(itemPath).data;
        let itemAfter = getAfter(itemPath).data;
        return !('stockRestoredAt' in resource.data)
               && resource.data.quantity is int
               && resource.data.quantity > 0
               && itemBefore.stock is int
               && itemAfter.stock is int
               && itemAfter.stock == itemBefore.stock + resource.data.quantity
               && itemAfter.stockReleaseOrderId == orderId;
      }

      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.customerId
                      || request.auth.uid == resource.data.merchantId);

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'itemId', 'customerId', 'merchantId',
                      'itemTitle', 'price', 'quantity', 'status', 'createdAt',
                      'deliveryAddress',
                      'fulfillmentType', 'paymentMethod', 'paymentStatus', 'approvalDeadlineAt',
                      'refundAt', 'cancelledAt', 'cancellationReason'
                    ])
                    && request.resource.data.keys().hasAll([
                      'itemId', 'customerId', 'merchantId', 'itemTitle',
                      'price', 'quantity', 'status', 'createdAt',
                      'deliveryAddress', 'fulfillmentType',
                      'paymentMethod', 'paymentStatus', 'approvalDeadlineAt'
                    ])
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && ((request.resource.data.paymentMethod == 'mock_card'
                         && request.resource.data.paymentStatus == 'demo_paid')
                        || (request.resource.data.paymentMethod in ['cash_on_delivery', 'pay_at_store']
                            && request.resource.data.paymentStatus == 'unpaid'))
                    && request.resource.data.paymentMethod in ['cash_on_delivery', 'pay_at_store', 'mock_card']
                    && request.resource.data.fulfillmentType in ['delivery', 'pickup']
                    && (request.resource.data.fulfillmentType == 'pickup'
                        || (request.resource.data.deliveryAddress is string
                            && request.resource.data.deliveryAddress.size() > 0))
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0
                    && (request.resource.data.price is int || request.resource.data.price is float)
                    && request.resource.data.price >= 0
                    && request.resource.data.createdAt is int
                    && request.resource.data.createdAt >= request.time.toMillis() - 300000
                    && request.resource.data.createdAt <= request.time.toMillis() + 300000
                    && request.resource.data.approvalDeadlineAt is int
                    && request.resource.data.approvalDeadlineAt == request.resource.data.createdAt + 1800000
                    && request.resource.data.itemId is string
                    && request.resource.data.merchantId is string
                    && request.resource.data.merchantId != ''
                    && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.merchantId == request.resource.data.merchantId
                    && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.title == request.resource.data.itemTitle
                    && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.price == request.resource.data.price
                    && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.isActive == true
                    && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.stock >= request.resource.data.quantity
                    && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.stock
                       == get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.stock - request.resource.data.quantity
                    && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.stockReservationOrderId == orderId;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status', 'paymentStatus', 'refundAt', 'cancelledAt', 'cancellationReason', 'stockRestoredAt'
                    ])
                    && ((request.auth.uid == resource.data.customerId
                         && resource.data.status == 'pending'
                         && request.resource.data.status == 'cancelled'
                         && request.resource.data.cancelledAt is int
                         && request.resource.data.cancellationReason == 'customer_cancelled'
                         && request.resource.data.stockRestoredAt is int
                         && stockReleaseMatchesOrder()
                         && ((resource.data.paymentStatus == 'demo_paid'
                              && request.resource.data.paymentStatus == 'demo_refunded'
                              && request.resource.data.refundAt is int
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'refundAt', 'cancelledAt', 'cancellationReason', 'stockRestoredAt']))
                             || (resource.data.paymentStatus != 'demo_paid'
                                 && request.resource.data.paymentStatus == resource.data.paymentStatus
                                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'stockRestoredAt']))))
                        || (request.auth.uid == resource.data.merchantId
                            && ((resource.data.status == 'pending'
                                 && ((request.resource.data.status == 'preparing'
                                      && (resource.data.paymentMethod != 'mock_card'
                                          || resource.data.paymentStatus == 'demo_paid'))
                                     || (request.resource.data.status == 'confirmed'
                                         && resource.data.paymentMethod == 'mock_card'
                                         && resource.data.paymentStatus == 'demo_paid')))
                                || (resource.data.status == 'confirmed'
                                    && request.resource.data.status == 'preparing'
                                    && (resource.data.paymentMethod != 'mock_card'
                                        || resource.data.paymentStatus == 'demo_paid'))
                                || (resource.data.status == 'preparing' && request.resource.data.status == 'ready')
                                || (resource.data.status == 'ready'
                                    && ((resource.data.fulfillmentType == 'delivery' && request.resource.data.status == 'out_for_delivery')
                                        || (resource.data.fulfillmentType == 'pickup' && request.resource.data.status == 'delivered')))
                                || (resource.data.status == 'out_for_delivery' && request.resource.data.status == 'delivered')
                                || (resource.data.status in ['pending', 'confirmed']
                                    && request.resource.data.status == 'cancelled'
                                    && request.resource.data.cancelledAt is int
                                    && request.resource.data.cancellationReason == 'merchant_cancelled'
                                    && request.resource.data.stockRestoredAt is int
                                    && stockReleaseMatchesOrder()
                                    && ((resource.data.paymentStatus == 'demo_paid'
                                         && request.resource.data.paymentStatus == 'demo_refunded'
                                         && request.resource.data.refundAt is int
                                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'refundAt', 'cancelledAt', 'cancellationReason', 'stockRestoredAt']))
                                        || (resource.data.paymentStatus != 'demo_paid'
                                            && request.resource.data.paymentStatus == resource.data.paymentStatus
                                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'stockRestoredAt'])))))));
      allow delete: if false;
    }

    // Hizmetler Koleksiyonu
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MERCHANT'
                    && request.resource.data.merchantId == request.auth.uid
                    && request.resource.data.depositAmount is number
                    && request.resource.data.depositAmount >= 0
                    && request.resource.data.depositAmount <= request.resource.data.price * 0.5;
      allow update: if request.auth != null
                    && resource.data.merchantId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MERCHANT'
                    && request.resource.data.merchantId == resource.data.merchantId
                    && request.resource.data.depositAmount is number
                    && request.resource.data.depositAmount >= 0
                    && request.resource.data.depositAmount <= request.resource.data.price * 0.5;
      allow delete: if request.auth != null
                    && resource.data.merchantId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MERCHANT';
    }

    // Randevular: yalnızca müşteri ve ilgili esnaf okuyabilir.
    match /appointments/{appointmentId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.customerId
                      || request.auth.uid == resource.data.merchantId);

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'customerId', 'merchantId', 'serviceId', 'serviceTitle',
                      'price', 'depositAmount', 'depositPaidAt', 'date', 'time', 'note', 'status', 'createdAt',
                      'serviceLocation', 'serviceAddress', 'depositPaymentStatus',
                      'depositRefundAt', 'balancePaymentStatus', 'balancePaymentRequestedAt', 'balancePaidAt',
                      'cancelledAt', 'cancellationReason', 'slotDateKey', 'slotTimeKey'
                    ])
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && ((request.resource.data.depositAmount > 0
                         && request.resource.data.depositPaymentStatus == 'demo_paid'
                         && request.resource.data.depositPaidAt is int)
                        || (request.resource.data.depositAmount == 0
                            && request.resource.data.depositPaymentStatus == 'not_required'
                            && request.resource.data.depositPaidAt == null))
                    && request.resource.data.balancePaymentStatus == 'unpaid'
                    && request.resource.data.serviceLocation in ['at_business', 'at_customer']
                    && (request.resource.data.serviceLocation == 'at_business'
                        || (request.resource.data.serviceAddress is string
                            && request.resource.data.serviceAddress.size() > 0))
                    && request.resource.data.serviceId is string
                    && request.resource.data.slotDateKey is string
                    && request.resource.data.slotDateKey.matches('^[0-9]{8}$')
                    && request.resource.data.slotTimeKey is string
                    && request.resource.data.slotTimeKey.matches('^[0-9]{4}$')
                    && getAfter(/databases/$(database)/documents/appointment_slots/$(request.resource.data.merchantId)/days/$(request.resource.data.slotDateKey)/times/$(request.resource.data.slotTimeKey)).data.appointmentId == appointmentId
                    && getAfter(/databases/$(database)/documents/appointment_slots/$(request.resource.data.merchantId)/days/$(request.resource.data.slotDateKey)/times/$(request.resource.data.slotTimeKey)).data.customerId == request.auth.uid
                    && getAfter(/databases/$(database)/documents/appointment_slots/$(request.resource.data.merchantId)/days/$(request.resource.data.slotDateKey)/times/$(request.resource.data.slotTimeKey)).data.serviceId == request.resource.data.serviceId
                    && getAfter(/databases/$(database)/documents/appointment_slots/$(request.resource.data.merchantId)/days/$(request.resource.data.slotDateKey)/times/$(request.resource.data.slotTimeKey)).data.date == request.resource.data.date
                    && getAfter(/databases/$(database)/documents/appointment_slots/$(request.resource.data.merchantId)/days/$(request.resource.data.slotDateKey)/times/$(request.resource.data.slotTimeKey)).data.time == request.resource.data.time
                    && request.resource.data.depositAmount is number
                    && request.resource.data.depositAmount >= 0
                    && request.resource.data.depositAmount <= request.resource.data.price * 0.5
                    && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.merchantId == request.resource.data.merchantId
                    && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.title == request.resource.data.serviceTitle
                    && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.price == request.resource.data.price
                    && ((('depositAmount' in get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data)
                         && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.depositAmount == request.resource.data.depositAmount)
                        || (!('depositAmount' in get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data)
                            && request.resource.data.depositAmount == 0))
                    && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.isActive == true
                    && get(/databases/$(database)/documents/users/$(request.resource.data.merchantId)).data.role == 'MERCHANT';

      allow update: if request.auth != null
                    && (!('slotDateKey' in resource.data)
                        || !(request.resource.data.status in ['cancelled', 'rejected', 'completed'])
                        || !existsAfter(/databases/$(database)/documents/appointment_slots/$(resource.data.merchantId)/days/$(resource.data.slotDateKey)/times/$(resource.data.slotTimeKey)))
                    && ((request.auth.uid == resource.data.customerId
                         && resource.data.status == 'approved'
                         && resource.data.depositPaymentStatus == 'unpaid'
                         && resource.data.depositAmount > 0
                         && request.resource.data.depositPaymentStatus == 'demo_paid'
                         && request.resource.data.depositPaidAt is int
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['depositPaymentStatus', 'depositPaidAt']))
                         || (request.auth.uid == resource.data.customerId
                             && resource.data.status in ['pending', 'approved']
                             && request.resource.data.status == 'cancelled'
                             && request.resource.data.cancelledAt is int
                             && request.resource.data.cancellationReason == 'customer_cancelled'
                             && ((resource.data.depositPaymentStatus == 'demo_paid'
                                  && request.resource.data.depositPaymentStatus == 'demo_refunded'
                                  && request.resource.data.depositRefundAt is int
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'depositPaymentStatus', 'depositRefundAt']))
                                 || (resource.data.depositPaymentStatus != 'demo_paid'
                                     && request.resource.data.depositPaymentStatus == resource.data.depositPaymentStatus
                                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason']))))
                        || (request.auth.uid == resource.data.customerId
                            && resource.data.status == 'service_completed'
                            && resource.data.balancePaymentStatus == 'requested'
                            && request.resource.data.status == 'completed'
                            && request.resource.data.balancePaymentStatus == 'demo_paid'
                            && request.resource.data.balancePaidAt is int
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'balancePaymentStatus', 'balancePaidAt']))
                        || (request.auth.uid == resource.data.merchantId
                            && ((resource.data.status == 'pending'
                                 && request.resource.data.status in ['approved', 'rejected']
                                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                                || (resource.data.status == 'approved'
                                    && request.resource.data.status == 'service_completed'
                                    && resource.data.depositPaymentStatus in ['not_required', 'demo_paid', 'cash_paid']
                                    && request.resource.data.balancePaymentStatus == 'requested'
                                    && request.resource.data.balancePaymentRequestedAt is int
                                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'balancePaymentStatus', 'balancePaymentRequestedAt']))
                                || (resource.data.status in ['approved', 'service_completed']
                                    && request.resource.data.status == 'completed'
                                    && resource.data.depositPaymentStatus in ['not_required', 'demo_paid', 'cash_paid']
                                    && request.resource.data.balancePaymentStatus == 'cash_paid'
                                    && request.resource.data.balancePaidAt is int
                                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'balancePaymentStatus', 'balancePaidAt'])))));

      allow delete: if false;
    }

    // A deterministic slot document prevents two requests reserving the same merchant time.
    match /appointment_slots/{merchantId}/days/{dateKey}/times/{timeKey} {
      allow read: if request.auth != null
                  && (request.auth.uid == merchantId
                      || !exists(/databases/$(database)/documents/appointment_slots/$(merchantId)/days/$(dateKey)/times/$(timeKey))
                      || request.auth.uid == resource.data.customerId);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.customerId
                    && request.resource.data.merchantId == merchantId
                    && request.resource.data.slotDateKey == dateKey
                    && request.resource.data.slotTimeKey == timeKey
                    && request.resource.data.keys().hasOnly([
                      'appointmentId', 'customerId', 'merchantId', 'serviceId',
                      'date', 'time', 'slotDateKey', 'slotTimeKey'
                    ])
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.customerId == request.auth.uid
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.merchantId == merchantId
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotDateKey == dateKey
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotTimeKey == timeKey
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.serviceId == request.resource.data.serviceId
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.time == request.resource.data.time;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.customerId || request.auth.uid == merchantId)
                    && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status in ['cancelled', 'rejected', 'completed'];
      allow update: if false;
    }

    match /merchant_conversations/{conversationId} {
      function activityUpdateMatchesMessage() {
        return request.resource.data.lastMessageId is string
               && existsAfter(/databases/$(database)/documents/merchant_messages/$(request.resource.data.lastMessageId))
               && getAfter(/databases/$(database)/documents/merchant_messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
               && getAfter(/databases/$(database)/documents/merchant_messages/$(request.resource.data.lastMessageId)).data.customerId == resource.data.customerId
               && getAfter(/databases/$(database)/documents/merchant_messages/$(request.resource.data.lastMessageId)).data.merchantId == resource.data.merchantId
               && getAfter(/databases/$(database)/documents/merchant_messages/$(request.resource.data.lastMessageId)).data.createdAt == request.resource.data.lastMessageAt;
      }

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['customerId', 'merchantId', 'createdAt', 'lastMessageAt', 'lastMessageId', 'status'])
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.merchantId is string
                    && request.resource.data.merchantId != request.auth.uid
                    && request.resource.data.createdAt is int
                    && request.resource.data.createdAt >= request.time.toMillis() - 300000
                    && request.resource.data.createdAt <= request.time.toMillis() + 300000
                    && request.resource.data.lastMessageAt is int
                    && request.resource.data.lastMessageAt == request.resource.data.createdAt
                    && request.resource.data.lastMessageId is string
                    && request.resource.data.status == 'active'
                    && conversationId == request.resource.data.merchantId + '--' + request.resource.data.customerId
                    && get(/databases/$(database)/documents/users/$(request.resource.data.merchantId)).data.role == 'MERCHANT';
      allow get: if request.auth != null
                 && (request.auth.uid == resource.data.customerId
                     || request.auth.uid == resource.data.merchantId
                     || conversationId.matches('.*--' + request.auth.uid + '$'));
      allow list: if request.auth != null
                  && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.merchantId);
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.merchantId)
                    && ((!('status' in resource.data) || resource.data.status == 'active')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageId'])
                        && request.resource.data.lastMessageAt is int
                        && request.resource.data.lastMessageAt >= request.time.toMillis() - 300000
                        && request.resource.data.lastMessageAt <= request.time.toMillis() + 300000
                        && activityUpdateMatchesMessage()
                        || (request.auth.uid == resource.data.merchantId
                            && request.resource.data.status == 'closed'
                            && request.resource.data.closedAt is int
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt'])));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.merchantId
                    && resource.data.status == 'closed';
    }

    // Esnafa ulaş sohbeti: mesajlarda kullanıcı profili yerine yalnızca taraf UID'leri bulunur.
    match /merchant_messages/{messageId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'senderId', 'customerId', 'merchantId', 'message', 'createdAt',
                      'attachmentPath', 'attachmentName',
                      'attachmentMimeType', 'attachmentType', 'attachmentSizeBytes'
                    ])
                    && request.resource.data.keys().hasAll([
                      'senderId', 'customerId', 'merchantId', 'message', 'createdAt'
                    ])
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.customerId is string
                    && request.resource.data.customerId != ''
                    && request.resource.data.merchantId is string
                    && request.resource.data.merchantId != ''
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && (request.resource.data.message.size() > 0
                        || ('attachmentPath' in request.resource.data
                            && request.resource.data.attachmentPath is string
                            && request.resource.data.attachmentPath.size() > 0))
                    && ((request.auth.uid == request.resource.data.customerId
                         && get(/databases/$(database)/documents/users/$(request.resource.data.merchantId)).data.role == 'MERCHANT')
                        || request.auth.uid == request.resource.data.merchantId)
                    && existsAfter(/databases/$(database)/documents/merchant_conversations/$(request.resource.data.merchantId + '--' + request.resource.data.customerId))
                    && getAfter(/databases/$(database)/documents/merchant_conversations/$(request.resource.data.merchantId + '--' + request.resource.data.customerId)).data.customerId == request.resource.data.customerId
                    && getAfter(/databases/$(database)/documents/merchant_conversations/$(request.resource.data.merchantId + '--' + request.resource.data.customerId)).data.merchantId == request.resource.data.merchantId
                    && (!('status' in getAfter(/databases/$(database)/documents/merchant_conversations/$(request.resource.data.merchantId + '--' + request.resource.data.customerId)).data)
                        || getAfter(/databases/$(database)/documents/merchant_conversations/$(request.resource.data.merchantId + '--' + request.resource.data.customerId)).data.status == 'active')
                    && getAfter(/databases/$(database)/documents/merchant_conversations/$(request.resource.data.merchantId + '--' + request.resource.data.customerId)).data.lastMessageAt == request.resource.data.createdAt
                    && getAfter(/databases/$(database)/documents/merchant_conversations/$(request.resource.data.merchantId + '--' + request.resource.data.customerId)).data.lastMessageId == messageId
                    && (!('attachmentPath' in request.resource.data)
                        || (request.resource.data.attachmentPath is string
                            && request.resource.data.attachmentPath.size() <= 300
                            && request.resource.data.attachmentName is string
                            && request.resource.data.attachmentName.size() <= 120
                            && request.resource.data.attachmentMimeType is string
                            && request.resource.data.attachmentMimeType.size() <= 120
                            && request.resource.data.attachmentType in ['image', 'video', 'file']
                            && request.resource.data.attachmentSizeBytes is int
                            && request.resource.data.attachmentSizeBytes <= 104857600
                            && (request.resource.data.attachmentType == 'video'
                                || request.resource.data.attachmentSizeBytes <= 26214400)));

      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.merchantId
                      || request.auth.uid == resource.data.customerId
                      || (!('customerId' in resource.data) && request.auth.uid == resource.data.senderId));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.merchantId
                    && ((('customerId' in resource.data)
                         && get(/databases/$(database)/documents/merchant_conversations/$(resource.data.merchantId + '--' + resource.data.customerId)).data.status == 'closed')
                        || (!('customerId' in resource.data)
                            && get(/databases/$(database)/documents/merchant_conversations/$(resource.data.merchantId + '--' + resource.data.senderId)).data.status == 'closed'));
      allow update: if false;
    }

    // Destek Talepleri
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'userEmail', 'subject', 'message', 'createdAt'])
                    && request.resource.data.keys().hasAll(['uid', 'subject', 'message', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0
                    && request.resource.data.subject.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 4000
                    && request.resource.data.createdAt is int;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update, delete: if false;
    }
  }
}
